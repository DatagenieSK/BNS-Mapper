{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BNSMapperChapterSectionList",
  "description": "Schema for IPC to BNS sections mapping dataset per chapter",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "bns",
      "ipc",
      "title",
      "chapter",
      "change",
      "old_text",
      "new_text",
      "punishment_old",
      "punishment_new",
      "explanation",
      "tags",
      "verified",
      "source"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^(ipc|bns)-[a-zA-Z0-9_().-]+$",
        "description": "Unique identifier for the mapping, e.g. bns-103"
      },
      "bns": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Array of BNS section numbers, or ['Omitted'] if omitted"
      },
      "ipc": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Array of corresponding IPC section numbers, or ['None'] if brand new"
      },
      "title": {
        "type": "string",
        "minLength": 2,
        "description": "Subject title of the provision"
      },
      "chapter": {
        "type": "string",
        "enum": [
          "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X",
          "XI", "XII", "XIII", "XIV", "XV", "XVI", "XVII", "XVIII", "XIX", "XX"
        ],
        "description": "BNS Chapter Roman numeral (I to XX)"
      },
      "change": {
        "type": "string",
        "enum": ["renumbered", "modified", "merged", "split", "new", "omitted"],
        "description": "Nature of the transition from IPC to BNS"
      },
      "old_text": {
        "type": "string",
        "description": "Operative summary of previous IPC provision"
      },
      "new_text": {
        "type": "string",
        "description": "Operative summary of new BNS provision"
      },
      "punishment_old": {
        "type": "string",
        "description": "Punishment under IPC"
      },
      "punishment_new": {
        "type": "string",
        "description": "Punishment under BNS"
      },
      "explanation": {
        "type": "string",
        "description": "Plain English summary, 2-3 sentences"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Keywords and search tags"
      },
      "verified": {
        "type": "boolean",
        "description": "Manual verification flag"
      },
      "source": {
        "type": "string",
        "description": "Official Gazette citation"
      }
    },
    "additionalProperties": false
  }
}
